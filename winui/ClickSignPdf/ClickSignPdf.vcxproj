<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{7C3F2E10-4B5A-4E8E-9B4C-8E0A51D1F001}</ProjectGuid>
    <RootNamespace>ClickSignPdf</RootNamespace>
    <ProjectName>ClickSignPdf</ProjectName>
    <DefaultLanguage>ro-RO</DefaultLanguage>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>

    <!-- Unpackaged: a signing tool must read and write arbitrary paths and
         reach smartcards, so it is a plain desktop app, not an MSIX one.
         Set this to true and add a Package.appxmanifest to ship via MSIX. -->
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationType>Windows Store</ApplicationType>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration><Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration><Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <WarningLevel>Level4</WarningLevel>
      <!-- The engine and its view model, plus PoDoFo and OpenSSL. -->
      <AdditionalIncludeDirectories>
        $(ProjectDir)..\..\src;
        $(ProjectDir)..\ViewModel;
        $(PODOFO_PREFIX)\include;
        $(OPENSSL_PREFIX)\include;
        $(CURL_PREFIX)\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>
        podofo.lib;libcrypto.lib;libcurl.lib;crypt32.lib;ws2_32.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalLibraryDirectories>
        $(PODOFO_PREFIX)\lib;$(OPENSSL_PREFIX)\lib;$(CURL_PREFIX)\lib;%(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>app.manifest</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>

    <!-- Presentation logic: plain C++, no WinRT, shared with the CMake build
         so it is compiled on every platform and cannot quietly become
         Windows-only. -->
    <ClCompile Include="..\ViewModel\MainViewModel.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>

    <!-- The signing engine. Same sources the CLI builds. -->
    <ClCompile Include="..\..\src\OpenSslSupport.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\SigningIdentity.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\DocumentSource.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\SignatureAppearance.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\DocumentSigner.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\SignatureField.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\ValidationServices.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\ValidationDataStore.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\DocumentTimestamp.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\HttpClient.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\HttpTimestampService.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\HttpOcspResponder.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\SampleDoc.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
    <ClCompile Include="..\..\src\SigningFacade.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h"><DependentUpon>App.xaml</DependentUpon></ClInclude>
    <ClInclude Include="MainWindow.xaml.h"><DependentUpon>MainWindow.xaml</DependentUpon></ClInclude>
  </ItemGroup>

  <ItemGroup>
    <Midl Include="App.idl" />
    <Midl Include="MainWindow.idl" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI 3 ships in the Windows App SDK, not the Windows SDK. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240607001" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405.15" />
    <PackageReference Include="Microsoft.Windows.ImplementationLibrary" Version="1.0.240122.1" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
